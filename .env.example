# Buddhi Labs website – PRIVATE environment variables (copy to .env; .env is git-ignored and never committed)
# PUBLIC values (company details, emails shown on the site, Formspree endpoint, analytics IDs, site keys) do NOT go here –
# they live in assets/js/business-config.js. This file is for server-side/deployment values only.
# GitHub Pages deployment needs NONE of these – they matter only for the optional Docker/VPS + backend setup.

# ---- Docker Compose (docker-compose.prod.yml) ----
DOMAIN=buddhilabs.bikashkadayat.com.np
APEX_DOMAIN=                       # leave empty for a subdomain deployment (no apex redirect)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- Backend (mirrors backend/.env.example) ----
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://buddhilabs.bikashkadayat.com.np,http://localhost:8000
SALES_EMAIL=
SUPPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DATABASE_URL=
RECAPTCHA_SECRET=
TURNSTILE_SECRET=
FORM_PROVIDER=formspree            # informational; the browser reads business-config.js
FORMSPREE_ENDPOINT=                # informational copy of the public endpoint
