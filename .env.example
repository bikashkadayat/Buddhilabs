# Buddhi Labs website – environment variables (copy to .env; never commit .env)
# Front-end runtime values are in assets/js/site-config.js (public by design – no secrets there).

# ---- docker-compose.prod.yml ----
DOMAIN=www.buddhilabs.com
APEX_DOMAIN=buddhilabs.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- Backend: see backend/.env.example for the full list (ALLOWED_ORIGINS, NOTIFY_EMAIL_TO, SMTP_*, RECAPTCHA_SECRET_KEY) ----

# ---- Reference values that must match site-config.js ----
SITE_URL=https://www.buddhilabs.com
FORM_PROVIDER=none               # none | custom | formspree | netlify
CONTACT_FORM_ENDPOINT=
RECAPTCHA_SITE_KEY=
SALES_EMAIL=
SUPPORT_EMAIL=
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GOOGLE_SITE_VERIFICATION=
