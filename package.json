{
  "name": "buddhilabs-website",
  "version": "3.0.0",
  "private": true,
  "description": "Buddhi Labs official website \u2013 static HTML + compiled Tailwind CSS",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/input.css -o ./assets/css/site.min.css --watch",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/site.min.css --minify",
    "build:js": "esbuild assets/js/main.js assets/js/contact-form.js --minify --outdir=assets/js --out-extension:.js=.min.js --log-level=warning",
    "build": "npm run build:css && npm run build:js",
    "serve": "python3 -m http.server 8000",
    "set-domain": "node scripts/set-domain.js",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.14"
  }
}
