# Backend environment - copy to backend/.env (never commit .env)
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://www.buddhilabs.com,http://localhost:8000
TRUST_PROXY=true                 # true behind nginx/Caddy so rate limiting sees the real client IP
# Storage: leave DATABASE_URL empty to use SQLite at DB_PATH
DATABASE_URL=                    # postgres://buddhi:PASSWORD@db:5432/buddhilabs
DB_PATH=/data/leads.db
# Email notification (SMTP) - all three SMTP_HOST/SMTP_USER/SMTP_PASS are required to enable email
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Spam protection
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5
