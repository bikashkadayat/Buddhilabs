# Backend environment – copy to backend/.env (git-ignored, never commit). Not used by the GitHub Pages deployment.
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://buddhilabs.bikashkadayat.com.np,http://localhost:8000
TRUST_PROXY=true                 # true behind nginx/Caddy so rate limiting sees the real client IP
# Storage: leave DATABASE_URL empty to use SQLite at DB_PATH
DATABASE_URL=                    # postgres://buddhi:PASSWORD@db:5432/buddhilabs
DB_PATH=/data/leads.db
# Email notification (SMTP) – SMTP_HOST, SMTP_USER and SMTP_PASSWORD (alias SMTP_PASS) are required to enable email
NOTIFY_EMAIL_TO=
SALES_EMAIL=
SUPPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Spam protection (secret keys – server only)
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
TURNSTILE_SECRET=
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5
